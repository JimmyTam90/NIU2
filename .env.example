# Public site URL used for canonical, Open Graph, sitemap and robots. Set to the real deployed domain.
NEXT_PUBLIC_SITE_URL=https://primegearlab.com
# Optional public tracking IDs. Leave unset to disable. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
